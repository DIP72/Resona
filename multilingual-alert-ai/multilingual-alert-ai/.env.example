# Copy this file to .env and adjust as needed.

# ---------------------------------------------------------------------
# Mode switch
# ---------------------------------------------------------------------
# true  = DEMO mode: lightweight dictionary/template translator.
#         No model download, no GPU, runs anywhere, instant startup.
# false = REAL MODEL mode: loads a real HF neural MT model at startup
#         (requires torch + transformers installed, internet access or a
#         pre-downloaded local model cache, and ideally a GPU).
DEMO_MODE=true

# Only used when DEMO_MODE=false
REAL_TRANSLATION_MODEL_ID=ai4bharat/indictrans2-en-indic-1B
REAL_MODEL_DEVICE=cpu

# Language detection: below this confidence, the API attaches a warning
# instead of silently trusting the guessed source language.
LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.55

# Caching
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=5000

# Low-bandwidth (SMS) message max length
LOW_BANDWIDTH_MAX_CHARS=160
